prisma
    datasource db {
      provider = "mysql"
      url      = env("DATABASE_URL") // Gunakan variabel environment
    }

    // Definisikan model data Anda di sini
    model Pendaftar {
      id                Int      @id @default(autoincrement())
      nomorPendaftaran  String   @unique
      nama              String
      sekolahAsal       String
      statusDaftarUlang String // Atau gunakan Enum
      tanggalDaftar     DateTime @default(now())
    }
